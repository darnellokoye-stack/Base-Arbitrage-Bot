51:2;20840:9;20836:18;20827:6;20783:72;:::i;:::-;20530:332;;;;;:::o;20868:164::-;21008:16;21004:1;20996:6;20992:14;20985:40;20868:164;:::o;21038:366::-;21180:3;21201:67;21265:2;21260:3;21201:67;:::i;:::-;21194:74;;21277:93;21366:3;21277:93;:::i;:::-;21395:2;21390:3;21386:12;21379:19;;21038:366;;;:::o;21410:419::-;21576:4;21614:2;21603:9;21599:18;21591:26;;21663:9;21657:4;21653:20;21649:1;21638:9;21634:17;21627:47;21691:131;21817:4;21691:131;:::i;:::-;21683:139;;21410:419;;;:::o;21835:165::-;21975:17;21971:1;21963:6;21959:14;21952:41;21835:165;:::o;22006:366::-;22148:3;22169:67;22233:2;22228:3;22169:67;:::i;:::-;22162:74;;22245:93;22334:3;22245:93;:::i;:::-;22363:2;22358:3;22354:12;22347:19;;22006:366;;;:::o;22378:419::-;22544:4;22582:2;22571:9;22567:18;22559:26;;22631:9;22625:4;22621:20;22617:1;22606:9;22602:17;22595:47;22659:131;22785:4;22659:131;:::i;:::-;22651:139;;22378:419;;;:::o","linkReferences":{},"immutableReferences":{"1192":[{"start":362,"length":32},{"start":992,"length":32},{"start":1296,"length":32}]}},"methodIdentifiers":{"executeMultiHop((address,address,uint256,bytes)[],uint256,uint256,uint256)":"683ef8fa","router()":"f887ea40"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.19+commit.7dd6d404\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_router\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[{\"components\":[{\"internalType\":\"address\",\"name\":\"tokenIn\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"tokenOut\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amountOutMin\",\"type\":\"uint256\"},{\"internalType\":\"bytes\",\"name\":\"extraData\",\"type\":\"bytes\"}],\"internalType\":\"struct ISwapAdapter.Hop[]\",\"name\":\"hops\",\"type\":\"tuple[]\"},{\"internalType\":\"uint256\",\"name\":\"amountIn\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"amountOutMin\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"}],\"name\":\"executeMultiHop\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"amountOut\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"router\",\"outputs\":[{\"internalType\":\"contract IUniswapV2Router\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"executeMultiHop((address,address,uint256,bytes)[],uint256,uint256,uint256)\":{\"params\":{\"amountIn\":\"exact amount of hops[0].tokenIn to sell (already approved to this adapter)\",\"amountOutMin\":\"minimum acceptable FINAL amountOut (leg-level slippage guard)\",\"deadline\":\"unix timestamp passed straight through to the underlying router call.                     MUST be the caller's real submission-time deadline (e.g. TriangleArb's                     own `deadline` argument), NOT a freshly computed `block.timestamp + N`                     inside the adapter \\u2014 recomputing it at execution time makes the router's                     own deadline check a no-op, since `block.timestamp` there is always \\\"now.\\\"\",\"hops\":\"ordered chain of same-adapter hops; hops[0].tokenIn is what                     TriangleArb approved `amountIn` of; hops[i].tokenIn must equal                     hops[i-1].tokenOut for i > 0\"},\"returns\":{\"amountOut\":\"  actual amount of the final hop's tokenOut sent back to the caller (TriangleArb)\"}}},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"notice\":\"extraData is unused per-hop for this adapter (plain UniV2 path has no extra flags). Multi-hop chains are submitted as a SINGLE call to the router's native `swapExactTokensForTokens` with a multi-address path (e.g. [WETH, USDC, USDT]), rather than looping separate swaps \\u2014 this is both cheaper and matches how UniV2-style routers are designed to be used. Called via regular `call` from TriangleArb (see ISwapAdapter.sol for the execution model): pulls amountIn via transferFrom, swaps the whole chain in one router call, sends the final output back to the caller. DEADLINE: `deadline` is passed straight through to the router unchanged \\u2014 it is the caller's real submission-time deadline, not recomputed here. A previous version fabricated `block.timestamp + 300` inside this adapter, which made the router's own deadline check a no-op (it's always \\\"now\\\" at execution time); the real protection now lives at the router level too, not only in TriangleArb's outer `deadline` check.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/adapters/UniswapV2Adapter.sol\":\"UniswapV2Adapter\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":false,\"runs\":200},\"remappings\":[\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"contracts/adapters/ISwapAdapter.sol\":{\"keccak256\":\"0xba2a103ad3d4fbd428c6b5bc462891fdc8c1b4d47be7d8f81243ebc60c3548a2\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://6fa5665f72143d19d8bcae5f3066d0bb487b2a0110d0dacffe92a6509c9f854f\",\"dweb:/ipfs/QmU9iZqMAv97qjW6E7ovCDZJAyT42qgLLXisNRGaB6JXUh\"]},\"contracts/adapters/UniswapV2Adapter.sol\":{\"keccak256\":\"0x51ea64d517e5ef5a7525fec972e54ab2100db49ce2227414e88f60774d228348\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://15def189c650c98055b8b8443a855b44966bdfb1ab826238add1808ee1470156\",\"dweb:/ipfs/QmaYgcZqTmSRbe1RFE9rogFj5uWBVkHZyo4S8mudD1QwxQ\"]},\"contracts/interfaces/IUniswapV2Router.sol\":{\"keccak256\":\"0xa5788e3e94f6c53013aed0865f54d8fd2353d7b19b1de9489fb145530a6edb8c\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://6dd72230a513017eadecca95ae49a9d51037aa0b800e20a104ef0e8c5b816d82\",\"dweb:/ipfs/QmbBefg3BivsDpnkNwc2GGJV1PbNZ6hR4niQjd8uuiUASD\"]},\"contracts/libraries/SafeTransfer.sol\":{\"keccak256\":\"0xa991f59d329593d55e604fb1fd096c21256d1432e88db2e36cbee7efe8d5021a\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://8680c