ops; hops[0].tokenIn is what                     TriangleArb approved `amountIn` of; hops[i].tokenIn must equal                     hops[i-1].tokenOut for i > 0"},"returns":{"amountOut":"  actual amount of the final hop's tokenOut sent back to the caller (TriangleArb)"}}},"version":1},"userdoc":{"kind":"user","methods":{},"version":1}},"settings":{"remappings":["forge-std/=lib/forge-std/src/"],"optimizer":{"enabled":false,"runs":200},"metadata":{"bytecodeHash":"ipfs"},"compilationTarget":{"contracts/adapters/UniswapV2Adapter.sol":"UniswapV2Adapter"},"evmVersion":"paris","libraries":{}},"sources":{"contracts/adapters/ISwapAdapter.sol":{"keccak256":"0xba2a103ad3d4fbd428c6b5bc462891fdc8c1b4d47be7d8f81243ebc60c3548a2","urls":["bzz-raw://6fa5665f72143d19d8bcae5f3066d0bb487b2a0110d0dacffe92a6509c9f854f","dweb:/ipfs/QmU9iZqMAv97qjW6E7ovCDZJAyT42qgLLXisNRGaB6JXUh"],"license":"MIT"},"contracts/adapters/UniswapV2Adapter.sol":{"keccak256":"0x51ea64d517e5ef5a7525fec972e54ab2100db49ce2227414e88f60774d228348","urls":["bzz-raw://15def189c650c98055b8b8443a855b44966bdfb1ab826238add1808ee1470156","dweb:/ipfs/QmaYgcZqTmSRbe1RFE9rogFj5uWBVkHZyo4S8mudD1QwxQ"],"license":"MIT"},"contracts/interfaces/IUniswapV2Router.sol":{"keccak256":"0xa5788e3e94f6c53013aed0865f54d8fd2353d7b19b1de9489fb145530a6edb8c","urls":["bzz-raw://6dd72230a513017eadecca95ae49a9d51037aa0b800e20a104ef0e8c5b816d82","dweb:/ipfs/QmbBefg3BivsDpnkNwc2GGJV1PbNZ6hR4niQjd8uuiUASD"],"license":"MIT"},"contracts/libraries/SafeTransfer.sol":{"keccak256":"0xa991f59d329593d55e604fb1fd096c21256d1432e88db2e36cbee7efe8d5021a","urls":["bzz-raw://8680caeb77a902e5feb9b50458f2ac585153c3333ead98e4ddfacb813abbbf49","dweb:/ipfs/QmQJGjDHNoarwebDYyg7eBiTWNkM1dBuxxJEoScc4eBm7G"],"license":"MIT"}},"version":1},"id":5}